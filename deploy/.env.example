# Advisory rollout — configuration. Copy this file to ".env" and edit, then run install.sh / install.ps1.
#   cp .env.example .env     (Linux/Mac)
#   copy .env.example .env   (Windows)
# Every value here has a safe default EXCEPT SQL_SA_PASSWORD, which you MUST set.

# ─── Required ────────────────────────────────────────────────────────────────
# SQL Server SA password. Must meet complexity (upper+lower+digit, 8+ chars). No default — set it.
SQL_SA_PASSWORD=Change_this_Str0ng_Pass

# ─── Ports (change if these clash with something already on the host) ─────────
# NOTE: these are HOST ports only. Change them freely to avoid clashes (e.g. 8080 already taken → the
# console default is 8088). The in-container ports never change. If you front the stack with an HTTPS
# reverse proxy (e.g. Nginx Proxy Manager), point your public hostnames at these host ports; the console
# calls its API same-origin (/api), so no host is hard-coded in the UI.
CONSOLE_PORT=8088      # the web console (what the curation team opens)
API_PORT=5000          # the REST API (console talks to it; also proxied by the console at /api)
PROXY_PORT=8090        # the package firewall proxy (developers point pip/npm/nuget/go here)
NEXUS_PORT=8081        # the Nexus repository (internal; developers use the package proxy, not this)
SQL_PORT=1434          # SQL Server (host port only; in-network stays 1433)

# ─── Nexus admin (the repository's own login) ────────────────────────────────
# IMPORTANT: on first Nexus start, the initial admin password is generated inside the container at
# /nexus-data/admin.password. Log into the Nexus UI once, set a permanent password, then put it here.
NEXUS_USER=admin
NEXUS_PASS=admin123
NEXUS_AUTOPROVISION=false   # false = operators add ecosystems from the console; true = auto-seed defaults
NEXUS_POLL_SECONDS=30       # how often the gate re-evaluates quarantine

# ─── Single sign-on (optional; OFF by default) ───────────────────────────────
# Out of the box the splash shows a "Continue" button (testing). To require SSO:
#   1) set SSO_ENABLED=true  (rebuilds the console to show "Sign in with SSO")
#   2) register an app in Microsoft Entra ID (or your OIDC provider) and fill the four values below
#   3) re-run install.sh / install.ps1
SSO_ENABLED=false
AZURE_AD_INSTANCE=https://login.microsoftonline.com/
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_AUDIENCE=

# ─── AI assistant (optional) ─────────────────────────────────────────────────
# Powers "Ask AI", "Build rules with AI", and the per-decision rationale in the ledger.
# Without a key these features fall back to deterministic behaviour; everything else works.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional alternate AI channel (OpenAI-compatible) — leave blank to use Groq only.
OPENROUTER_API_KEY=

# ─── Premium threat intel (optional) ─────────────────────────────────────────
# The free path (OSV.dev + CISA KEV + EPSS + OpenSSF) works with none of these set.
VULNCHECK_API_KEY=
