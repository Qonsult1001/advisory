# Secrets — never commit
.env
*.env.local

# Build output
bin/
obj/
web/dist/
web/node_modules/

# Runtime data
*.jsonl
*.worm.jsonl
policy.json

# Node / build artifacts
node_modules/
**/node_modules/
target/
*.user

# Evolution harness runtime
.evolve/
evolution/bin/
evolution/harness/node_modules/

# Model caches / large binaries
tools/privacy-filter/node_modules/
*.onnx
*.onnx_data*

# OS / editor
.DS_Store
Thumbs.db
.claude/

# Track the mutate/evolve skills + commands, ignore the rest of .claude runtime
!.claude/
!.claude/commands/
!.claude/commands/**
!.claude/skills/
!.claude/skills/**
.claude/*
!.claude/commands
!.claude/skills

# Mutation queue (bind-mounted runtime data — request files dropped by the dashboard)
.evolution-queue/

# All runtime data now lives here in the dev root (visible, persistent)
data/
